# 密钥与本地配置
.env
.env.*
!.env.example
*.pem
*.key

# 真实数据（聊天记录 / 记忆 / 联系人 / 音频）
# 注意：必须写 data/*，不能写 data/ ——
# 目录整体被排除后，Git 不会再去恢复里面的单个文件
data/*
!data/README.md
!data/.gitkeep

# 备份与补丁
*.bak
*.leakbak-*
*.seedbak-*
*.applied-*
data/*.jsonl

# Python
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.venv/
venv/
*.egg-info/

# 本地工具产物
.memory-graph.html
memory-graph.html

# 编辑器/系统
.DS_Store
Thumbs.db
.vscode/
.idea/

# 未修复漏洞的审计报告：修完前不进公开仓库
docs/AUDIT-*.md
