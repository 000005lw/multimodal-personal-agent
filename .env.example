# ============================================================
# 复制这份文件为 .env，然后把值改成你自己的
# 注意：值后面不要写行内注释，会把注释当成值的一部分
# ============================================================

# ---------- 必填 ----------
# 你自己的 QQ 号。只有这个号发消息，小鲸鱼才会回。
OWNER_QQ=123456789

# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的key

# ---------- 模型（一般不用改） ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=1.3
DEEPSEEK_MAX_TOKENS=800

# ---------- 图片理解 ----------
# 主人发图时改用这个模型（deepseek-flash 支持视觉，deepseek-v4-pro 不支持）
VISION_ENABLED=true
DEEPSEEK_VISION_MODEL=deepseek-flash
# 一条消息最多看几张
VISION_MAX_IMAGES=3
# 单张图最大字节数（8MB），超了跳过
VISION_MAX_BYTES=8388608

# ---------- 表情包 ----------
# 图放 data/stickers/<情绪>/*.jpg，模型写 [[贴图:情绪]] 就发一张
STICKERS_ENABLED=true
# 一条回复最多几个
STICKER_MAX_PER_REPLY=1
# 模型没主动发时，按这个概率随机补一张（0 关闭，0.35 大约三条里一条）
STICKER_PROBABILITY=0.5

# ---------- 链接解析 ----------
# 发 B站/抖音 分享链接时，读标题和作者，让她知道你在看什么
LINK_PARSE_ENABLED=true

# ---------- 联网搜索 ----------
# 她写 [[搜索:关键词]] 时替她上网查（DeepSeek 搜索接口，5元/千次）
SEARCH_ENABLED=true
SEARCH_COUNT=5

# ---------- 视频抽帧 ----------
# 发 B站/抖音 视频链接时，下视频抽几帧给视觉模型看
# 需要服务器装 yt-dlp 和 ffmpeg，没装会自动跳过
VIDEO_FRAMES_ENABLED=false
VIDEO_MAX_FRAMES=4
# 什么时候把截帧发回来：ask 只在你要 / always 每次 / never 从不
VIDEO_SEND_MODE=ask

# ---------- 机器人监听（NapCat 把事件上报到这里） ----------
BOT_HOST=127.0.0.1
BOT_PORT=8090

# ---------- NapCat 的 HTTP API ----------
# 必须和 NapCat「网络配置 → HTTP 服务器」里的端口一致
ONEBOT_API_BASE=http://127.0.0.1:3000
# 和 NapCat 里填的 token 保持一致，没设就留空
ONEBOT_ACCESS_TOKEN=

# ---------- 家里电脑 relay ----------
# 服务器和家里中继使用同一个随机 token，不要提交真实值
HOME_TOKEN=
# 家里电脑通过 SSH 隧道访问服务器端口时使用
HOME_RELAY_URL=http://127.0.0.1:8091
# 家里中继连接服务器使用的 SSH 目标，例如 ubuntu@203.0.113.10
HOME_SSH_TARGET=
# 非 22 端口时填写
HOME_SSH_PORT=

# ---------- 行为 ----------
# 私聊里用小鲸鱼的"回复"气泡引用你的消息
QUOTE_REPLY=true
# 单条消息最多多少字，超了自动拆成几条发
MAX_REPLY_CHARS=900
# 模拟"看消息 + 打字"的延迟，更像真人
SIMULATE_TYPING=true
# 工具运行时默认关闭；测试和 canary 时再打开
ACTIONS_V2=false
# 只记录动作状态，不记录聊天原文或真实 QQ 号
ACTION_TRACE_ENABLED=true
ACTION_TRACE_FILE=action_trace.jsonl
# 把回复拆成 1~3 条短消息发，像真人一条条打
MULTI_BUBBLE=true
MULTI_BUBBLE_MAX=5
# 健康巡检间隔（秒），0 关闭
WATCHDOG_SECONDS=300
# 硬过滤括号里的动作描写（模型会模仿自己历史里的旧习惯）
STRIP_ACTIONS=true

# ---------- 语音 ----------
# 总开关。关掉之后「发语音」也不会触发
TTS_ENABLED=true
# espeak 零依赖（apt 装一个包即可），音质机械；tencent / aliyun 走云端，不占算力
TTS_ENGINE=aliyun
# espeak 的中文音色
TTS_VOICE=cmn
TTS_SPEED=165
TTS_PITCH=70
# 一段语音最多合成多少字
TTS_MAX_CHARS=200
# base64 最省事，不受路径权限影响
TTS_SEND_MODE=base64

# 阿里云语音合成（TTS_ENGINE=aliyun 时必填）
# 密钥：https://ram.console.aliyun.com/manage/ak
# AppKey：https://nls-portal.console.aliyun.com/ 创建项目后拿
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_APPKEY=
ALIYUN_NLS_REGION=cn-shanghai
# 默认女声 xiaoyun，可在控制台试听后换
ALIYUN_TTS_VOICE=xiaoyun
# 语速、音调，-500 ~ 500，0 正常
ALIYUN_TTS_SPEECH_RATE=0
ALIYUN_TTS_PITCH_RATE=0

# 腾讯云语音合成（TTS_ENGINE=tencent 时必填，当前未启用）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_VOICE=101001
TENCENT_TTS_SPEED=0
TENCENT_TTS_CODEC=mp3
# 逐字保留多少轮（一轮 = 你一句 + 它一句）
HISTORY_TURNS=120
# 逐字历史总字数上限，超了自动压缩成摘要
MAX_HISTORY_CHARS=40000
# 压缩出的长期摘要上限（字）
SUMMARY_MAX_CHARS=1500
# 人设文件
PERSONA_FILE=persona.md
# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# ---------- 群聊（默认关；你说只私聊就不用管） ----------
REPLY_TO_GROUPS=false
# 允许回复的群号，逗号分隔，留空表示所有群
GROUP_WHITELIST=

# ---------- 掉线邮件提醒 ----------
# QQ 邮箱设置里生成「SMTP 授权码」，不是登录密码
MAIL_ENABLED=true
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_FROM=
MAIL_AUTH_CODE=
MAIL_TO=

# ---------- 生图（通义万相） ----------
IMAGE_ENABLED=true
DASHSCOPE_API_KEY=
IMAGE_MODEL=wanx2.0-t2i-turbo
IMAGE_SIZE=1024*1024
IMAGE_TIMEOUT=90

# ---------- 主动发消息 ----------
PROACTIVE_ENABLED=true
PROACTIVE_MIN_MINUTES=120
PROACTIVE_MAX_MINUTES=300
PROACTIVE_IDLE_MINUTES=90
PROACTIVE_QUIET_START=1
PROACTIVE_QUIET_END=8
